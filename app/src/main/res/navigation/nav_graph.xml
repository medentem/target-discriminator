<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/ageVerificationFragment">

    <fragment
        android:id="@+id/ageVerificationFragment"
        android:name="com.targetdiscriminator.presentation.age_verification.AgeVerificationFragment"
        android:label="Age Verification"
        tools:layout="@layout/fragment_age_verification">
        <action
            android:id="@+id/action_ageVerificationFragment_to_sessionConfigFragment"
            app:destination="@id/sessionConfigFragment"
            app:popUpTo="@id/ageVerificationFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/sessionConfigFragment"
        android:name="com.targetdiscriminator.presentation.session_config.SessionConfigFragment"
        android:label="Session Configuration"
        tools:layout="@layout/fragment_session_config">
        <action
            android:id="@+id/action_sessionConfigFragment_to_trainingFragment"
            app:destination="@id/trainingFragment">
            <argument
                android:name="config"
                app:argType="com.targetdiscriminator.domain.model.SessionConfig" />
        </action>
        <action
            android:id="@+id/action_sessionConfigFragment_to_mediaManagementFragment"
            app:destination="@id/mediaManagementFragment" />
        <action
            android:id="@+id/action_sessionConfigFragment_to_mediaGalleryFragment"
            app:destination="@id/mediaGalleryFragment" />
    </fragment>

    <fragment
        android:id="@+id/mediaManagementFragment"
        android:name="com.targetdiscriminator.presentation.media_management.MediaManagementFragment"
        android:label="Manage Media"
        tools:layout="@layout/fragment_media_management">
        <action
            android:id="@+id/action_mediaManagementFragment_to_mediaGalleryFragment"
            app:destination="@id/mediaGalleryFragment" />
    </fragment>

    <fragment
        android:id="@+id/mediaGalleryFragment"
        android:name="com.targetdiscriminator.presentation.media_gallery.MediaGalleryFragment"
        android:label="Media Gallery"
        tools:layout="@layout/fragment_media_gallery">
        <action
            android:id="@+id/action_mediaGalleryFragment_to_mediaPreviewFragment"
            app:destination="@id/mediaPreviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/mediaPreviewFragment"
        android:name="com.targetdiscriminator.presentation.media_gallery.MediaPreviewFragment"
        android:label="Media Preview"
        tools:layout="@layout/fragment_media_preview">
        <argument
            android:name="mediaPath"
            app:argType="string" />
        <argument
            android:name="currentIndex"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/trainingFragment"
        android:name="com.targetdiscriminator.presentation.training.TrainingFragment"
        android:label="Training Session"
        tools:layout="@layout/fragment_training" />

</navigation>

